{
  "manifest_version": 3,
  "name": "一目 Glance ✦ 浏览器必备神器",
  "version": "2.4.0",
  "description": "标签页一目了然：IDE 风格目录树、分组、去重、定位、拖拽，← → 跨标签页前进后退，一键清理不常用页，按 链接/标题/内容/备注 搜索，支持收藏归档与最近浏览",
  "minimum_chrome_version": "114",
  "author": { "email": "570442340@qq.com" },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "tabGroups",
    "scripting",
    "contextMenus",
    "favicon",
    "history",
    "sessions"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["rail.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "打开「一目」侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "打开「一目」侧边栏"
    },
    "nav-back": {
      "suggested_key": { "default": "Alt+Shift+Left" },
      "description": "后退：回到上一个访问的标签页（跨窗口）"
    },
    "nav-forward": {
      "suggested_key": { "default": "Alt+Shift+Right" },
      "description": "前进：去往下一个访问的标签页（跨窗口）"
    }
  }
}
